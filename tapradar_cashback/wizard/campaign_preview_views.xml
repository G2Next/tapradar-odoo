<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tapradar_cashback_preview_view_form" model="ir.ui.view">
        <field name="name">tapradar.cashback.preview.form</field>
        <field name="model">tapradar.cashback.preview</field>
        <field name="arch" type="xml">
            <form string="Gift card preview">
                <group>
                    <group>
                        <field name="customer_count" string="Customers"/>
                        <field name="total_amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="customer_ref"/>
                        <field name="partner_id"/>
                        <field name="order_count"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="eligible_amount" sum="Total"/>
                        <field name="voucher_amount" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
