<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="tapradar_cashback.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]//div[hasclass('before-footer')]" position="inside">
            <div t-if="props.data.tapradarQr" class="pos-receipt-center-align tapradar-receipt-qr">
                <br/>
                <div>Your cashback gift cards in the TapRadar app:</div>
                <div>scan this code once in the app.</div>
                <img t-att-src="props.data.tapradarQr" class="pos-receipt-qrcode" alt="TapRadar"/>
            </div>
        </xpath>
    </t>
</templates>
