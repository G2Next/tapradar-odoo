<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="tapradar_cashback.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <t t-set="tapradarReceiptQr" t-value="this.tapradarQr"/>
            <div t-if="tapradarReceiptQr" class="pos-receipt-center-align text-center pt-3 tapradar-receipt-qr">
                <div>Your cashback gift cards in the TapRadar app:</div>
                <div>scan this code once in the app.</div>
                <img t-att-src="tapradarReceiptQr" class="pos-receipt-qrcode" alt="TapRadar"/>
            </div>
        </xpath>
    </t>
</templates>
