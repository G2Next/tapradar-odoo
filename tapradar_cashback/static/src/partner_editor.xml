<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="tapradar_cashback.PartnerDetailsEdit" t-inherit="point_of_sale.PartnerDetailsEdit" t-inherit-mode="extension">
        <xpath expr="//input[@id='vat']/.." position="after">
            <div class="partner-detail col tapradar-link-code">
                <label class="form-label label" for="tapradar_link_code">TapRadar-Code</label>
                <div t-if="props.partner.tapradar_linked" class="form-control-plaintext"><i class="fa fa-check text-success"/> Linked with TapRadar</div>
                <!-- Always offered: the shop can remove a link in the TapRadar portal, so a linked customer may need a new code. -->
                <input class="detail form-control" id="tapradar_link_code" name="tapradar_link_code"
                       t-model="changes.tapradar_link_code" placeholder="TRK… / TR-XXXX-XXXX"
                       autocomplete="off" autocapitalize="characters" spellcheck="false"/>
                <div class="form-text" t-if="props.partner.tapradar_linked">To link again, scan the TapRadar card or a new code from the customer's TapRadar app, then save.</div>
                <div class="form-text" t-else="">Scan the TapRadar card or the code from the customer's TapRadar app, then save.</div>
            </div>
        </xpath>
    </t>
</templates>
