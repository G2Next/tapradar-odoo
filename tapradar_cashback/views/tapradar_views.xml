<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tapradar" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tapradar.cashback</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="after">
                <block title="TapRadar" id="tapradar_cashback_section">
                    <setting string="Connection"
                             help="Cashback gift cards are delivered to your customers through the TapRadar app. Create the integration key in your TapRadar business account.">
                        <div class="mt-2" invisible="tapradar_integration_id">
                            <field name="tapradar_api_key" password="True" placeholder="trk_..."/>
                        </div>
                        <div class="mt-2">
                            <field name="tapradar_data_consent"/>
                            <label for="tapradar_data_consent" class="o_light_label"/>
                            <div class="text-muted">
                                Customer numbers and gift cards (code, value, validity, status) are sent to TapRadar.
                                Names are not sent.
                            </div>
                        </div>
                        <div class="mt-2" invisible="tapradar_integration_id">
                            <button name="action_tapradar_connect" type="object" string="Connect" class="btn-primary"/>
                        </div>
                        <div class="mt-2" invisible="not tapradar_integration_id">
                            <i class="fa fa-check text-success"/> Connected with
                            <field name="tapradar_shop_name" class="fw-bold"/>
                            <field name="tapradar_integration_id" invisible="1"/>
                            <button name="action_tapradar_disconnect" type="object" string="Disconnect"
                                    class="btn-link" confirm="Disconnect TapRadar? Active cashback campaigns stop reaching the app."/>
                        </div>
                    </setting>
                    <setting string="QR code on receipts"
                             help="Customers scan it in the TapRadar app once to link their customer number.">
                        <field name="tapradar_receipt_qr"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="tapradar_cashback_event_view_tree" model="ir.ui.view">
        <field name="name">tapradar.cashback.event.tree</field>
        <field name="model">tapradar.cashback.event</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="create_date" string="Queued"/>
                <field name="card_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'" decoration-danger="state == 'failed'"/>
                <field name="attempts"/>
                <field name="sent_at"/>
                <field name="last_error"/>
                <button name="action_retry" type="object" string="Retry" icon="fa-refresh"
                        invisible="state == 'sent'"/>
            </tree>
        </field>
    </record>

    <record id="tapradar_cashback_event_action" model="ir.actions.act_window">
        <field name="name">TapRadar Sync</field>
        <field name="res_model">tapradar.cashback.event</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_not_sent': 1}</field>
    </record>

    <record id="tapradar_cashback_event_view_search" model="ir.ui.view">
        <field name="name">tapradar.cashback.event.search</field>
        <field name="model">tapradar.cashback.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="card_id"/>
                <filter name="not_sent" string="Not sent" domain="[('state', '!=', 'sent')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <menuitem id="tapradar_cashback_event_menu"
              action="tapradar_cashback_event_action"
              name="TapRadar Sync"
              parent="point_of_sale.pos_config_menu_catalog"
              groups="point_of_sale.group_pos_manager"
              sequence="94"/>
</odoo>
